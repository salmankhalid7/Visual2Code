PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED_SHADOW=

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=v2c
GENERATION_QUEUE_NAME=generation
REDIS_CONNECT_TIMEOUT_MS=10000
QUEUE_OPERATION_TIMEOUT_MS=10000

WORKER_CONCURRENCY=4
WORKER_LOCK_DURATION_MS=30000
WORKER_STALLED_INTERVAL_MS=30000
WORKER_MAX_STALLED_COUNT=1

JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_DELAY_MS=2000
JOB_DEFAULT_PRIORITY=10
JOB_REMOVE_ON_COMPLETE_COUNT=500
JOB_REMOVE_ON_COMPLETE_AGE_SECONDS=86400
JOB_REMOVE_ON_FAIL_COUNT=1000
JOB_REMOVE_ON_FAIL_AGE_SECONDS=604800
JOB_MAX_INPUT_BYTES=16384
MOCK_GENERATION_DELAY_MS=250
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
